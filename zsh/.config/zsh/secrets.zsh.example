# copy to ~/.config/zsh/secrets.zsh. gitignored, sourced by .zshrc if present.
#
# tokens only. plaintext env vars are readable by every process I run and
# leak into `ps` output, so prefer a credential helper where one exists.

# export GITHUB_TOKEN="..."
# export ANTHROPIC_API_KEY="..."

# export AWS_PROFILE="profile"
# export AWS_REGION="us-east-1"

# private go module hosts. not a secret, but names internal infra.
# export GOPRIVATE="git.internal.example.com/,github.com/my-org/"
