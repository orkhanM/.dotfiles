# copy to ~/.ssh/config.local. gitignored.
#
# ForwardAgent is off in the committed config's wildcard on purpose: any host
# I connect to could use my loaded keys for the life of the connection. turn
# it on per-host instead.

# Host *.internal.example.com
#   ForwardAgent yes
#   ForwardX11 yes

# Host bastion
#   HostName bastion.example.com
#   User username
#   IdentityFile ~/.ssh/id_ed25519
